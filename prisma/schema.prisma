// Family Finance Hub data model — see project doc "expense-tracker-plan.md" (Phase 2 + 8.6/8.7)
// Production (Render + Supabase Postgres) — this copy is pre-switched from the sqlite
// schema used for local dev. If you keep iterating locally against SQLite, don't push this
// file's datasource block back over your local one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountTypeEnum {
  Expenditure
  Investment
  Income
  // Money moving between the household's own accounts — e.g. paying off a credit card from
  // savings. Not real spend (the spend already happened when the card was used) and not real
  // income/investment growth, so it must stay fully outside every Expenditure/Investment/Income
  // total. Deliberately its own AccountType, not a boolean flag on Transaction, so every existing
  // query that already filters positively by accountType (never by "everything else") excludes
  // these rows automatically, with no per-query exclusion logic to remember or forget.
  Transfer
}

enum TxnStatus {
  categorized
  needs_review
}

enum TxnSource {
  manual
  gmail_daily
  gmail_monthly_reconcile
  csv_import
  migration
}

enum AccountKind {
  bank_debit
  credit_card
  cash
  wallet
}

enum RuleMatchType {
  exact
  contains
  regex
}

enum RuleSource {
  seeded_from_history
  user_defined
  llm_suggested
  review_queue_created
}

// Top of the hierarchy — 1:1 with AccountType, verified against the historical mapping table.
model ExpenseNature {
  id          String          @id @default(cuid())
  name        String          @unique
  accountType AccountTypeEnum
  isActive    Boolean         @default(true)
  expenseTypes ExpenseType[]

  @@map("expense_natures")
}

model ExpenseType {
  id              String        @id @default(cuid())
  name            String
  expenseNatureId String
  expenseNature   ExpenseNature @relation(fields: [expenseNatureId], references: [id])
  isActive        Boolean       @default(true)
  categories      Category[]

  @@unique([name, expenseNatureId])
  @@map("expense_types")
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  expenseTypeId String
  expenseType   ExpenseType   @relation(fields: [expenseTypeId], references: [id])
  isActive      Boolean       @default(true)
  transactions  Transaction[]
  rules         CategoryRule[]

  @@map("categories")
}

model Account {
  id          String      @id @default(cuid())
  name        String      @unique // e.g. "iciciRiaSavings" — carried over from the sheet's "Spend On" values
  holder      String      // "Sangeeth" | "Ria"
  accountKind AccountKind
  institution String?     // "ICICI" | "SBI" | ...
  isActive    Boolean     @default(true) // false for legacy/migration-only accounts (Amex, Axis, HDFC, Cash, etc.)
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id              String      @id @default(cuid())
  txnDate         DateTime
  rawDescription  String
  amount          Decimal     // signed: negative = expense/outflow, positive = income/inflow
  currency        String      @default("INR")
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id])
  status          TxnStatus   @default(categorized)
  source          TxnSource
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])
  dedupeHash      String      @unique // hash(date + amount + accountId + normalized description)
  // Optional override: which calendar month this transaction counts toward for Dashboard/
  // Insights reporting (e.g. a credit-card charge dated the 30th that really belongs to next
  // month's statement). Stored as a UTC month-start (first-of-month) timestamp when set. txnDate
  // above is NEVER changed by this — it stays the real, immutable imported date for provenance;
  // this field is purely an additive "counts toward" tag, set from the Ledger. Null = no
  // override, use txnDate as-is (the overwhelming majority of rows).
  effectiveMonth  DateTime?
  suggestedCategoryId String?  // set when status=needs_review and a rule/LLM has a guess
  suggestionReason    String?  // human-readable "why" shown in the Review Queue
  legacyCalYear   Int?        // carried over from sheet for cross-checking during migration
  legacyFyYear    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([txnDate])
  @@index([categoryId])
  @@index([accountId])
  fundingLinks    FundingLink[]

  @@index([status])
  @@map("transactions")
}

model CategoryRule {
  id         String        @id @default(cuid())
  matchType  RuleMatchType
  pattern    String
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  priority   Int           @default(100) // lower = matched first
  source     RuleSource
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([pattern])
  @@map("category_rules")
}

// A description pattern the user has permanently opted out of reviewing — created by the
// Review Queue's "Discard forever" action. Deliberately separate from Transaction.status:
// dismissed transactions stay `needs_review` (they're still genuinely uncategorized, so
// Ledger's status filter and any future categorization pass still see them honestly) — this
// table only controls what the Review Queue *surfaces*, and covers future imports too, since
// the queue excludes any needs_review row whose normalized description matches a row here.
model ReviewDismissal {
  id                String   @id @default(cuid())
  descriptionKey    String   @unique // normalizeDescriptionKey(rawDescription) — same key the Review Queue groups by
  sampleDescription String   // one representative raw description, for display in the "restore" list
  dismissedCount    Int      @default(0) // how many needs_review rows matched at the moment of dismissal (informational only)
  createdAt         DateTime @default(now())

  @@map("review_dismissals")
}

model ImportBatch {
  id           String        @id @default(cuid())
  source       TxnSource
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       String        @default("running") // running | completed | failed
  rowsIn       Int           @default(0)
  rowsMatched  Int           @default(0)
  rowsNeedsReview Int        @default(0)
  notes        String?
  transactions Transaction[]

  @@map("import_batches")
}

// ─────────────────────────────────────────────────────────────────────────────────────────
// Portfolio tracking (US stocks first) — see project doc "us-portfolio-data-architecture.md".
// Additive only: nothing above is altered except the FundingLink back-relation on Transaction.
// Raw broker quantities/prices are stored exactly as the broker reported them; stock splits live
// in CorporateAction and are applied at read time. PriceDaily is AS-TRADED (unadjusted).
// Lots, disposals, IRR and tax views are derived, never stored.
// ─────────────────────────────────────────────────────────────────────────────────────────

enum PortfolioBroker {
  INDMONEY_ALPACA
  IBKR
}

enum TradeSide {
  BUY
  SELL
}

enum SecurityKind {
  STOCK
  ETF
  BENCHMARK
}

enum CashEventType {
  DIVIDEND
  WITHHOLDING_TAX
  FEE
  DEPOSIT
  WITHDRAWAL
  INTEREST
}

enum PortfolioSource {
  indmoney_report
  ibkr_api
  manual
}

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  SYMBOL_CHANGE
}

enum PortfolioReviewType {
  UNMAPPED_FUNDING
  UNITS_MISMATCH
  MISSING_PRICE
  MISSING_FX
  DUPLICATE_SUSPECT
  OTHER
}

enum PortfolioReviewStatus {
  open
  resolved
  dismissed
}

model PortfolioAccount {
  id           String                 @id @default(cuid())
  key          String                 @unique // stable slug used by ingest, e.g. INDMONEY_ALPACA, IBKR
  broker       PortfolioBroker
  name         String
  holder       String // family member; Sangeeth only for now, field retained for later
  baseCurrency String                 @default("USD")
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]
  snapshots    PositionSnapshot[]
  fundingLinks FundingLink[]

  @@map("portfolio_accounts")
}

model Security {
  id           String                 @id @default(cuid())
  symbol       String                 @unique
  name         String
  kind         SecurityKind           @default(STOCK)
  currency     String                 @default("USD")
  exchange     String?
  createdAt    DateTime               @default(now())
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]
  actions      CorporateAction[]
  prices       PriceDaily[]
  snapshots    PositionSnapshot[]

  @@map("securities")
}

model PortfolioTransaction {
  id            String                @id @default(cuid())
  accountId     String
  account       PortfolioAccount      @relation(fields: [accountId], references: [id])
  securityId    String
  security      Security              @relation(fields: [securityId], references: [id])
  side          TradeSide
  qty           Decimal               @db.Decimal(20, 8) // as reported by broker (pre-split units for pre-split trades)
  price         Decimal               @db.Decimal(20, 6) // as reported by broker
  fee           Decimal               @default(0) @db.Decimal(20, 8)
  currency      String                @default("USD")
  execTs        DateTime // UTC execution timestamp
  tradeDate     DateTime              @db.Date // US session date (America/New_York)
  source        PortfolioSource
  brokerRef     String // broker id: INDmoney Broker Reference Id / IBKR trade_id
  importBatchId String?
  importBatch   PortfolioImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime              @default(now())

  @@unique([source, brokerRef])
  @@index([accountId, tradeDate])
  @@index([securityId, tradeDate])
  @@map("portfolio_transactions")
}

model CashEvent {
  id            String                @id @default(cuid())
  accountId     String
  account       PortfolioAccount      @relation(fields: [accountId], references: [id])
  securityId    String?
  security      Security?             @relation(fields: [securityId], references: [id])
  type          CashEventType
  amount        Decimal               @db.Decimal(20, 6) // signed, account currency
  currency      String                @default("USD")
  eventDate     DateTime              @db.Date
  source        PortfolioSource
  brokerRef     String
  notes         String?
  importBatchId String?
  importBatch   PortfolioImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime              @default(now())

  @@unique([source, brokerRef])
  @@index([accountId, eventDate])
  @@map("cash_events")
}

model CorporateAction {
  id            String              @id @default(cuid())
  securityId    String
  security      Security            @relation(fields: [securityId], references: [id])
  type          CorporateActionType
  effectiveDate DateTime            @db.Date // first session trading on the new basis
  ratio         Decimal             @db.Decimal(20, 8) // new shares per old share
  source        String?
  createdAt     DateTime            @default(now())

  @@unique([securityId, effectiveDate, type])
  @@map("corporate_actions")
}

model PriceDaily {
  id               String   @id @default(cuid())
  securityId       String
  security         Security @relation(fields: [securityId], references: [id])
  date             DateTime @db.Date
  close            Decimal  @db.Decimal(20, 6) // as-traded, NOT split-adjusted
  dividendPerShare Decimal? @db.Decimal(20, 6) // as-traded
  source           String   @default("yfinance")
  createdAt        DateTime @default(now())

  @@unique([securityId, date])
  @@map("prices_daily")
}

model FxDaily {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  pair   String // e.g. USDINR
  rate   Decimal  @db.Decimal(14, 6)
  source String   @default("yfinance")

  @@unique([pair, date])
  @@map("fx_daily")
}

// Official/tax reference rates (e.g. SBI TT buying rate) for Schedule FA / capital-gains INR conversion.
model TaxFxRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  pair      String
  rate      Decimal  @db.Decimal(14, 6)
  rateBasis String // e.g. SBI_TT_BUY
  source    String?

  @@unique([pair, date, rateBasis])
  @@map("tax_fx_rates")
}

// Broker-reported holdings at a point in time — used ONLY to reconcile units rebuilt from trades.
model PositionSnapshot {
  id         String           @id @default(cuid())
  accountId  String
  account    PortfolioAccount @relation(fields: [accountId], references: [id])
  securityId String
  security   Security         @relation(fields: [securityId], references: [id])
  asOf       DateTime         @db.Date
  qty        Decimal          @db.Decimal(20, 8) // current (post-split) units
  source     String
  createdAt  DateTime         @default(now())

  @@unique([accountId, securityId, asOf])
  @@map("position_snapshots")
}

// Links an INR outflow in the expense ledger to a USD funding of a portfolio account.
model FundingLink {
  id            String           @id @default(cuid())
  transactionId String
  transaction   Transaction      @relation(fields: [transactionId], references: [id])
  accountId     String
  account       PortfolioAccount @relation(fields: [accountId], references: [id])
  usdAmount     Decimal?         @db.Decimal(20, 6)
  fundedOn      DateTime?        @db.Date
  notes         String?
  createdAt     DateTime         @default(now())

  @@unique([transactionId, accountId])
  @@map("funding_links")
}

model TaxRuleSet {
  id                String    @id @default(cuid())
  jurisdiction      String // e.g. IN
  assetClass        String // e.g. FOREIGN_LISTED_EQUITY
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  ltThresholdMonths Int
  ltRate            Decimal?  @db.Decimal(6, 4)
  stRateNote        String? // ST gains taxed at slab; kept as note
  notes             String?
  createdAt         DateTime  @default(now())

  @@map("tax_rule_sets")
}

model PortfolioImportBatch {
  id           String                 @id @default(cuid())
  source       PortfolioSource
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  status       String                 @default("running") // running | completed | failed
  rowsIn       Int                    @default(0)
  rowsInserted Int                    @default(0)
  rowsSkipped  Int                    @default(0)
  notes        String?
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]

  @@map("portfolio_import_batches")
}

model PortfolioReviewItem {
  id         String                @id @default(cuid())
  type       PortfolioReviewType
  status     PortfolioReviewStatus @default(open)
  refTable   String?
  refId      String?
  detail     String
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("portfolio_review_items")
}
