// Family Finance Hub data model — see project doc "expense-tracker-plan.md" (Phase 2 + 8.6/8.7)
// Production (Render + Supabase Postgres) — this copy is pre-switched from the sqlite
// schema used for local dev. If you keep iterating locally against SQLite, don't push this
// file's datasource block back over your local one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountTypeEnum {
  Expenditure
  Investment
  Income
  // Money moving between the household's own accounts — e.g. paying off a credit card from
  // savings. Not real spend (the spend already happened when the card was used) and not real
  // income/investment growth, so it must stay fully outside every Expenditure/Investment/Income
  // total. Deliberately its own AccountType, not a boolean flag on Transaction, so every existing
  // query that already filters positively by accountType (never by "everything else") excludes
  // these rows automatically, with no per-query exclusion logic to remember or forget.
  Transfer
}

enum TxnStatus {
  categorized
  needs_review
}

enum TxnSource {
  manual
  gmail_daily
  gmail_monthly_reconcile
  csv_import
  migration
}

enum AccountKind {
  bank_debit
  credit_card
  cash
  wallet
}

enum RuleMatchType {
  exact
  contains
  regex
}

enum RuleSource {
  seeded_from_history
  user_defined
  llm_suggested
  review_queue_created
}

// Top of the hierarchy — 1:1 with AccountType, verified against the historical mapping table.
model ExpenseNature {
  id          String          @id @default(cuid())
  name        String          @unique
  accountType AccountTypeEnum
  isActive    Boolean         @default(true)
  expenseTypes ExpenseType[]

  @@map("expense_natures")
}

model ExpenseType {
  id              String        @id @default(cuid())
  name            String
  expenseNatureId String
  expenseNature   ExpenseNature @relation(fields: [expenseNatureId], references: [id])
  isActive        Boolean       @default(true)
  categories      Category[]

  @@unique([name, expenseNatureId])
  @@map("expense_types")
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  expenseTypeId String
  expenseType   ExpenseType   @relation(fields: [expenseTypeId], references: [id])
  isActive      Boolean       @default(true)
  transactions  Transaction[]
  rules         CategoryRule[]
  retirementLinks RetirementBaselineLink[]

  @@map("categories")
}

model Account {
  id          String      @id @default(cuid())
  name        String      @unique // e.g. "iciciRiaSavings" — carried over from the sheet's "Spend On" values
  holder      String      // "Sangeeth" | "Ria"
  accountKind AccountKind
  institution String?     // "ICICI" | "SBI" | ...
  isActive    Boolean     @default(true) // false for legacy/migration-only accounts (Amex, Axis, HDFC, Cash, etc.)
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id              String      @id @default(cuid())
  txnDate         DateTime
  rawDescription  String
  amount          Decimal     // signed: negative = expense/outflow, positive = income/inflow
  currency        String      @default("INR")
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id])
  status          TxnStatus   @default(categorized)
  source          TxnSource
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])
  dedupeHash      String      @unique // hash(date + amount + accountId + normalized description)
  // Optional override: which calendar month this transaction counts toward for Dashboard/
  // Insights reporting (e.g. a credit-card charge dated the 30th that really belongs to next
  // month's statement). Stored as a UTC month-start (first-of-month) timestamp when set. txnDate
  // above is NEVER changed by this — it stays the real, immutable imported date for provenance;
  // this field is purely an additive "counts toward" tag, set from the Ledger. Null = no
  // override, use txnDate as-is (the overwhelming majority of rows).
  effectiveMonth  DateTime?
  suggestedCategoryId String?  // set when status=needs_review and a rule/LLM has a guess
  suggestionReason    String?  // human-readable "why" shown in the Review Queue
  legacyCalYear   Int?        // carried over from sheet for cross-checking during migration
  legacyFyYear    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([txnDate])
  @@index([categoryId])
  @@index([accountId])
  fundingLinks    FundingLink[]

  @@index([status])
  @@map("transactions")
}

model CategoryRule {
  id         String        @id @default(cuid())
  matchType  RuleMatchType
  pattern    String
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  priority   Int           @default(100) // lower = matched first
  source     RuleSource
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([pattern])
  @@map("category_rules")
}

// A description pattern the user has permanently opted out of reviewing — created by the
// Review Queue's "Discard forever" action. Deliberately separate from Transaction.status:
// dismissed transactions stay `needs_review` (they're still genuinely uncategorized, so
// Ledger's status filter and any future categorization pass still see them honestly) — this
// table only controls what the Review Queue *surfaces*, and covers future imports too, since
// the queue excludes any needs_review row whose normalized description matches a row here.
model ReviewDismissal {
  id                String   @id @default(cuid())
  descriptionKey    String   @unique // normalizeDescriptionKey(rawDescription) — same key the Review Queue groups by
  sampleDescription String   // one representative raw description, for display in the "restore" list
  dismissedCount    Int      @default(0) // how many needs_review rows matched at the moment of dismissal (informational only)
  createdAt         DateTime @default(now())

  @@map("review_dismissals")
}

model ImportBatch {
  id           String        @id @default(cuid())
  source       TxnSource
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       String        @default("running") // running | completed | failed
  rowsIn       Int           @default(0)
  rowsMatched  Int           @default(0)
  rowsNeedsReview Int        @default(0)
  notes        String?
  transactions Transaction[]

  @@map("import_batches")
}

// ─────────────────────────────────────────────────────────────────────────────────────────
// Portfolio tracking (US stocks first) — see project doc "us-portfolio-data-architecture.md".
// Additive only: nothing above is altered except the FundingLink back-relation on Transaction.
// Raw broker quantities/prices are stored exactly as the broker reported them; stock splits live
// in CorporateAction and are applied at read time. PriceDaily is AS-TRADED (unadjusted).
// Lots, disposals, IRR and tax views are derived, never stored.
// ─────────────────────────────────────────────────────────────────────────────────────────

enum PortfolioBroker {
  INDMONEY_ALPACA
  IBKR
  KABIR_PMS // Kabir Capital Advisors LLP - Two Rules Value Fund (India equity PMS, held in Ria's demat via Nuvama)
  MF_FOLIO // A mutual fund folio sourced from a CAMS/KFintech Consolidated Account Statement. One row per (AMC, folio no.); RTA (CAMS vs KFintech) is per-folio metadata, not a separate broker.
  RETIREMENT_TRACKED // EPF/NPS (and similar) sourced from the INDmoney MCP as a rolled-up total only — no unit-level data available. One account per family member; paired with an AGGREGATE_VALUE security, qty fixed at 1.
}

enum TradeSide {
  BUY
  SELL
}

enum SecurityKind {
  STOCK
  ETF
  BENCHMARK
  MUTUAL_FUND // liquid/arbitrage funds a PMS parks idle cash in; not a portfolio "holding" the client chose
  AGGREGATE_VALUE // a value-only holding with no real per-unit price (e.g. EPF/NPS from INDmoney, rolled up); qty is fixed at 1 and PriceDaily.close carries the whole position's INR value. Excluded from the Yahoo Finance price-refresh job by kind, same as MUTUAL_FUND.
}

enum CashEventType {
  DIVIDEND
  WITHHOLDING_TAX
  FEE
  DEPOSIT
  WITHDRAWAL
  INTEREST
}

enum PortfolioSource {
  indmoney_report
  ibkr_api
  manual
  kabir_pms_report // Nuvama Wealthspectrum portal exports, read via Chrome under the user's logged-in session
  cams_cas_pdf // CAMS/KFintech Consolidated Account Statement, manually uploaded periodically (see mf-equity-irr-tracking-proposal.md)
}

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  SYMBOL_CHANGE
  BONUS // Indian-equity corporate actions; not yet observed in the Kabir PMS data (added ahead of need)
  RIGHTS
  DEMERGER
}

enum PortfolioReviewType {
  UNMAPPED_FUNDING
  UNITS_MISMATCH
  MISSING_PRICE
  MISSING_FX
  DUPLICATE_SUSPECT
  OTHER
}

enum PortfolioReviewStatus {
  open
  resolved
  dismissed
}

model PortfolioAccount {
  id           String                 @id @default(cuid())
  key          String                 @unique // stable slug used by ingest, e.g. INDMONEY_ALPACA, IBKR
  broker       PortfolioBroker
  name         String
  holder       String // family member; Sangeeth only for now, field retained for later
  baseCurrency String                 @default("USD")
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]
  snapshots    PositionSnapshot[]
  fundingLinks FundingLink[]

  @@map("portfolio_accounts")
}

model Security {
  id           String                 @id @default(cuid())
  symbol       String                 @unique
  name         String
  kind         SecurityKind           @default(STOCK)
  currency     String                 @default("USD")
  exchange     String?
  createdAt    DateTime               @default(now())
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]
  actions      CorporateAction[]
  prices       PriceDaily[]
  snapshots    PositionSnapshot[]

  @@map("securities")
}

model PortfolioTransaction {
  id            String                @id @default(cuid())
  accountId     String
  account       PortfolioAccount      @relation(fields: [accountId], references: [id])
  securityId    String
  security      Security              @relation(fields: [securityId], references: [id])
  side          TradeSide
  qty           Decimal               @db.Decimal(20, 8) // as reported by broker (pre-split units for pre-split trades)
  price         Decimal               @db.Decimal(20, 6) // as reported by broker
  fee           Decimal               @default(0) @db.Decimal(20, 8)
  currency      String                @default("USD")
  execTs        DateTime // UTC execution timestamp
  tradeDate     DateTime              @db.Date // US session date (America/New_York)
  source        PortfolioSource
  brokerRef     String // broker id: INDmoney Broker Reference Id / IBKR trade_id; for cams_cas_pdf, a deterministic hash of (folio, ISIN, date, description, amount, units) since CAMS gives no stable transaction id
  switchGroupId String? // links a same-day switch-out + switch-in pair across two folios for display; null when not a switch or the pair couldn't be matched. Never read by IRR/lot math - purely an audit/display aid.
  importBatchId String?
  importBatch   PortfolioImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime              @default(now())

  @@unique([source, brokerRef])
  @@index([accountId, tradeDate])
  @@index([securityId, tradeDate])
  @@map("portfolio_transactions")
}

model CashEvent {
  id            String                @id @default(cuid())
  accountId     String
  account       PortfolioAccount      @relation(fields: [accountId], references: [id])
  securityId    String?
  security      Security?             @relation(fields: [securityId], references: [id])
  type          CashEventType
  amount        Decimal               @db.Decimal(20, 6) // signed, account currency
  currency      String                @default("USD")
  eventDate     DateTime              @db.Date
  source        PortfolioSource
  brokerRef     String
  notes         String?
  importBatchId String?
  importBatch   PortfolioImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime              @default(now())

  @@unique([source, brokerRef])
  @@index([accountId, eventDate])
  @@map("cash_events")
}

model CorporateAction {
  id            String              @id @default(cuid())
  securityId    String
  security      Security            @relation(fields: [securityId], references: [id])
  type          CorporateActionType
  effectiveDate DateTime            @db.Date // first session trading on the new basis
  ratio         Decimal             @db.Decimal(20, 8) // new shares per old share
  source        String?
  createdAt     DateTime            @default(now())

  @@unique([securityId, effectiveDate, type])
  @@map("corporate_actions")
}

model PriceDaily {
  id               String   @id @default(cuid())
  securityId       String
  security         Security @relation(fields: [securityId], references: [id])
  date             DateTime @db.Date
  close            Decimal  @db.Decimal(20, 6) // as-traded, NOT split-adjusted
  dividendPerShare Decimal? @db.Decimal(20, 6) // as-traded
  source           String   @default("yfinance")
  createdAt        DateTime @default(now())

  @@unique([securityId, date])
  @@map("prices_daily")
}

model FxDaily {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  pair   String // e.g. USDINR
  rate   Decimal  @db.Decimal(14, 6)
  source String   @default("yfinance")

  @@unique([pair, date])
  @@map("fx_daily")
}

// Official/tax reference rates (e.g. SBI TT buying rate) for Schedule FA / capital-gains INR conversion.
model TaxFxRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  pair      String
  rate      Decimal  @db.Decimal(14, 6)
  rateBasis String // e.g. SBI_TT_BUY
  source    String?

  @@unique([pair, date, rateBasis])
  @@map("tax_fx_rates")
}

// Broker-reported holdings at a point in time — used ONLY to reconcile units rebuilt from trades.
model PositionSnapshot {
  id         String           @id @default(cuid())
  accountId  String
  account    PortfolioAccount @relation(fields: [accountId], references: [id])
  securityId String
  security   Security         @relation(fields: [securityId], references: [id])
  asOf       DateTime         @db.Date
  qty        Decimal          @db.Decimal(20, 8) // current (post-split) units
  source     String
  createdAt  DateTime         @default(now())

  @@unique([accountId, securityId, asOf])
  @@map("position_snapshots")
}

// Links an INR outflow in the expense ledger to a USD funding of a portfolio account.
model FundingLink {
  id            String           @id @default(cuid())
  transactionId String
  transaction   Transaction      @relation(fields: [transactionId], references: [id])
  accountId     String
  account       PortfolioAccount @relation(fields: [accountId], references: [id])
  usdAmount     Decimal?         @db.Decimal(20, 6)
  fundedOn      DateTime?        @db.Date
  notes         String?
  createdAt     DateTime         @default(now())

  @@unique([transactionId, accountId])
  @@map("funding_links")
}

model TaxRuleSet {
  id                String    @id @default(cuid())
  jurisdiction      String // e.g. IN
  assetClass        String // e.g. FOREIGN_LISTED_EQUITY
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  ltThresholdMonths Int
  ltRate            Decimal?  @db.Decimal(6, 4)
  stRateNote        String? // ST gains taxed at slab; kept as note
  notes             String?
  createdAt         DateTime  @default(now())

  @@map("tax_rule_sets")
}

model PortfolioImportBatch {
  id           String                 @id @default(cuid())
  source       PortfolioSource
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  status       String                 @default("running") // running | completed | failed
  rowsIn       Int                    @default(0)
  rowsInserted Int                    @default(0)
  rowsSkipped  Int                    @default(0)
  notes        String?
  transactions PortfolioTransaction[]
  cashEvents   CashEvent[]

  @@map("portfolio_import_batches")
}

model PortfolioReviewItem {
  id         String                @id @default(cuid())
  type       PortfolioReviewType
  status     PortfolioReviewStatus @default(open)
  refTable   String?
  refId      String?
  detail     String
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("portfolio_review_items")
}

// ─────────────────────────────────────────────────────────────────────────────────────────
// Retirement planning — see project docs "retirement-in-financer-criteria-and-integration.md"
// and "retirement-financer-m1-engine-log.md". Additive only: the sole change above is the
// RetirementBaselineLink back-relation on Category (no column or table altered).
// Design rules: (1) baseline spend is typed by the user and never overwritten by a sync; the
// ledger is shown beside it as a trailing-12-month reference, computed at read time and never
// stored. (2) Every save creates an immutable RetirementPlanVersion snapshot, so a result can
// always be reproduced from the exact inputs that produced it. (3) All money is ₹ lakh, the
// engine's unit (src/lib/retirement).
// ─────────────────────────────────────────────────────────────────────────────────────────

enum RetirementBaselineGroup {
  spend // the 12 sub-buckets (monthly, today's money)
  fixed // health, insurance, school, EMI
  asset // opening pool, EPF/NPS
  income // rent, Generali sum assured base
  netWorth // tracked-only: net worth by asset class (not fed into compute())
}

enum RetirementBaselineUnit {
  monthly
  annual
  lump
}

enum RetirementEventKind {
  expense // today's money, inflated at CPI to the event year
  inflow // nominal amount in the event year
}

model RetirementPlan {
  id                String                   @id @default(cuid())
  name              String
  // Household by default; a per-person plan can be added later without a schema change.
  scope             String                   @default("household")
  // Working copies edited on screen. Engine Params and Assumptions as JSON, validated in
  // src/lib/retirement/store.ts before every write. A saved version snapshots these.
  params            Json
  assumptions       Json
  // Drift flag: a baseline row is flagged when its trailing-12-month ledger actual differs from
  // the typed value by more than this percentage. User-set, plan-wide.
  driftThresholdPct Decimal                  @default(10) @db.Decimal(5, 2)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  archivedAt        DateTime?
  baselineItems     RetirementBaselineItem[]
  lifeEvents        RetirementLifeEvent[]
  versions          RetirementPlanVersion[]

  @@map("retirement_plans")
}

model RetirementBaselineItem {
  id             String                   @id @default(cuid())
  planId         String
  plan           RetirementPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Stable key the engine reads: sub.food, sub.home, ... health, insurance, school, emi,
  // openingPool, rent, epf, genSumAssured.
  key            String
  label          String
  group          RetirementBaselineGroup
  unit           RetirementBaselineUnit
  valueL         Decimal                  @db.Decimal(14, 4) // ₹ lakh per `unit`, today's money
  // When the user last confirmed this number. A ledger sync never touches it.
  lastReviewedAt DateTime                 @default(now())
  note           String?
  sortOrder      Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  ledgerLinks    RetirementBaselineLink[]

  @@unique([planId, key])
  @@map("retirement_baseline_items")
}

// Which ledger categories feed the trailing-12-month reference shown beside a baseline row.
// A real FK to Category (categories are deactivated, never hard-deleted), so a mapping cannot
// silently dangle. Reference only: this table never changes a baseline value.
model RetirementBaselineLink {
  itemId     String
  item       RetirementBaselineItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category               @relation(fields: [categoryId], references: [id])

  @@id([itemId, categoryId])
  @@index([categoryId])
  @@map("retirement_baseline_links")
}

model RetirementLifeEvent {
  id        String              @id @default(cuid())
  planId    String
  plan      RetirementPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  year      Int
  label     String
  kind      RetirementEventKind
  amountL   Decimal             @db.Decimal(14, 4)
  note      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([planId, year])
  @@map("retirement_life_events")
}

// Immutable. Created on every explicit "save version"; never updated.
model RetirementPlanVersion {
  id            String         @id @default(cuid())
  planId        String
  plan          RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  label         String?
  // Full input state at save time: params, assumptions, baseline items (with lastReviewedAt),
  // life events. Enough to reproduce the result with the engine version below.
  snapshot      Json
  engineVersion String
  // Result recorded at save time so versions can be compared without recomputing.
  successPct    Decimal?       @db.Decimal(5, 2)
  band          String? // Adequate | Just enough | Inadequate
  depletionYear Int? // deterministic path depletion year, null if it lasts to 2082
  createdAt     DateTime       @default(now())

  @@unique([planId, version])
  @@map("retirement_plan_versions")
}
