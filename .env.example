DATABASE_URL="file:./dev.db"
INGEST_API_KEY="replace-with-a-real-secret"

# --- Auth (Google OAuth, identity-only) ---
# Create these at https://console.cloud.google.com/apis/credentials (OAuth client ID, type
# "Web application"). Authorized redirect URI: <your-deployed-url>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
# Random secret NextAuth uses to sign session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# The app's own base URL. http://localhost:3000 for local dev; your real Vercel/custom domain
# in production (NextAuth needs this to build correct callback URLs).
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated allowlist — only these Google accounts may sign in. No other identity check
# exists; an empty/unset value locks everyone out (fails closed, not open).
ALLOWED_EMAILS="sangeeth.aloysius@gmail.com,riaishere@gmail.com"
